          {
            "key": "score",
            "label": "综合评分（1-5）",
            "type": "number"
          },
          {
            "key": "comment",
            "label": "评语",
            "type": "textarea"
          }
        ]
      },
      "remark": "三维评价 + 拒答纠偏，输出综合评分与评语",
      "sort": 40
    },
