{
  "specs": [
    {
      "code": "kefu_detail",
      "name": "智能客服会话明细",
      "kind": "detail",
      "task_type": "detail_gen",
      "source_code": "",
      "tags": {
        "业务": "景区服务",
        "任务": "客服对话",
        "类型": "明细",
        "领域": "旅游"
      },
      "config": {
        "unit_label": "会话",
        "dimensions": [
          {
            "var": "category",
            "label": "覆盖类目",
            "mode": "rotate",
            "dict": "categories",
            "value_field": "category",
            "filterable": true,
            "child": {
              "var": "sub_scene",
              "field": "sub_scenes",
              "take": 1
            }
          },
          {
            "var": "shape",
            "label": "会话形态",
            "mode": "weighted",
            "dict": "dialog_shapes",
            "value_field": "name",
            "weight_field": "weight",
            "filterable": true,
            "extra": {
              "shape_desc": "desc",
              "turn_hint": "turns"
            }
          }
        ],
        "variables": {
          "scenic_profile": "综合型 5A 景区：含大门票与套票、观光车与索道、机动游乐区、景区酒店、文创店、演艺剧场，日均客流 2~4 万人次，暑期为旺季"
        },
        "required": [
          "turns"
        ],
        "dedup_field": "turns.0.question",
        "avoid_field": "turns.0.question",
        "conv_fields": [
          {
            "key": "category",
            "label": "类目",
            "list": true
          },
          {
            "key": "sub_scene",
            "label": "细分场景",
            "list": true
          },
          {
            "key": "shape",
            "label": "会话形态",
            "list": true
          },
          {
            "key": "scene_desc",
            "label": "会话背景"
          },
          {
            "key": "visitor_tag",
            "label": "游客标签"
          },
          {
            "key": "difficulty",
            "label": "难度"
          }
        ],
        "turn_fields": [
          {
            "key": "question",
            "label": "游客提问"
          },
          {
            "key": "reply",
            "label": "客服应答"
          },
          {
            "key": "intent_1",
            "path": "thought.意图1.名称",
            "label": "意图1"
          },
          {
            "key": "slots_1",
            "path": "thought.意图1.槽位",
            "label": "意图1槽位",
            "fmt": "json"
          },
          {
            "key": "intent_2",
            "path": "thought.意图2.名称",
            "label": "意图2"
          },
          {
            "key": "slots_2",
            "path": "thought.意图2.槽位",
            "label": "意图2槽位",
            "fmt": "json"
          },
          {
            "key": "emotion",
            "label": "情绪"
          }
        ],
        "turn_view": [
          {
            "key": "question",
            "label": "游客提问",
            "role": "user",
            "editable": true
          },
          {
            "key": "reply",
            "label": "客服应答",
            "role": "assistant",
            "editable": true
          }
        ]
      },
      "remark": "一条 = 一段完整会话（1~5 轮），覆盖票务/交通/酒店/文创/客诉等类目",
      "sort": 10
    },
    {
      "code": "kefu_sft",
      "name": "智能客服对话训练集",
      "kind": "sft",
      "task_type": "ai_label",
      "source_code": "kefu_detail",
      "tags": {
        "业务": "景区服务",
        "任务": "客服对话",
        "类型": "SFT",
        "领域": "旅游"
      },
      "config": {
        "unit_label": "会话",
        "expand": {
          "field": "turns",
          "history_template": "用户：{{question}}\n客服：{{reply}}",
          "history_var": "history",
          "index_var": "turn_index",
          "total_var": "turn_total"
        },
        "sample_id_template": "scenic_slot_{{conv_id}}_t{{turn_index}}",
        "messages": [
          {
            "role": "system",
            "content": "你是一个专业的景区智能客服。请根据历史对话识别用户当前意图，提取相关槽位，并给出回复。必须在<thought>标签内完成意图分类和历史切片。多意图需分别处理。"
          },
          {
            "role": "user",
            "content": "{{#history}}历史对话：\n{{history}}\n{{/history}}当前问题：{{question}}"
          },
          {
            "role": "assistant",
            "content": "<thought>{{thought|json}}</thought>{{reply}}"
          }
        ],
        "validators": [
          {
            "type": "json_key",
            "field": "thought",
            "key": "意图1",
            "label": "思维链"
          },
          {
            "type": "nonempty",
            "field": "reply",
            "label": "回复正文"
          }
        ],
        "ai_fields": [
          {
            "key": "thought",
            "label": "意图与槽位（thought）",
            "type": "intents"
          },
          {
            "key": "reply",
            "label": "客服回复",
            "type": "textarea"
          }
        ]
      },
      "remark": "会话按轮次滑窗展开，history 自动拼接前序轮次",
      "sort": 20
    },
